# --- Supabase (öffentliche Werte, landen im Browser-Bundle) -------------------
# Dashboard → Project Settings → API (bzw. "API Keys")
# Ohne diese Werte läuft die App im lokalen Modus: alles bleibt auf dem Gerät.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# "anon"/"publishable" Key – NIEMALS den service_role/secret Key hier eintragen.
VITE_SUPABASE_ANON_KEY=

# --- Debug-Panel ---------------------------------------------------------------
# Im Dev-Server immer verfügbar (mit ?debug=true).
# In Builds nur, wenn hier true – empfohlen: nur für Cloudflare-PREVIEW-Deployments.
VITE_ENABLE_DEBUG=false
